# Admin UI and /admin API bearer token. Set to a long random string.
ADMIN_TOKEN=
# Optional key protecting /v1/*. Leave blank for loopback-only usage.
PROXY_API_KEY=
# Path to the channel seed file used on first start.
POLYGATE_CONFIG=deploy/providers.toml
# SQLite database (metrics rollups, events, provider overrides).
POLYGATE_DATABASE=data/polygate.db

# Upstream credentials, referenced by api_key_env in provider configs.
AMR_API_KEY=
ZEN_API_KEY=
OK8888_API_KEY=

# Optional per-caller key; uncomment in providers.toml only when set.
# TEAM_A_KEY=
