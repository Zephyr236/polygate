{
  "name": "polygate-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "mutate": "stryker run",
    "crap": "crap coverage/coverage-final.json --json crap-report/crap-report.json --html /dev/null 2>/dev/null || crap coverage/coverage-final.json --json crap-report/crap-report.json",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "crap-score": "1.2.1",
    "dependency-cruiser": "^18.8.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.5.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jscpd": "^4.3.0",
    "jsdom": "31.0.1",
    "knip": "^5.88.1",
    "msw": "2.15.0",
    "prettier": "3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "^7.3.8",
    "vitest": "4.1.12"
  }
}
