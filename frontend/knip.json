{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "e2e/**/*.spec.ts",
    "tests/**/*.test.{ts,tsx}",
    "*.config.ts"
  ],
  "rules": {
    "exports": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "off",
    "files": "error"
  },
  "ignoreDependencies": [
    "jscpd"
  ]
}
